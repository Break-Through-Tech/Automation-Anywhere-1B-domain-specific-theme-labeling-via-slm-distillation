{
  "model_name": "meta-llama/Llama-3.2-3B-Instruct",
  "dataset": "bitext/Bitext-customer-support-llm-chatbot-training-dataset",
  "domain": "IT",
  "split_mode": "raw",
  "samples": 500,
  "top_k": 10,
  "teacher_llm": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5",
    "max_tokens": 60
  },
  "training": {
    "num_train_epochs": 3,
    "per_device_train_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0002,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.05
  },
  "lora": {
    "r": 16,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "task_type": "CAUSAL_LM"
  }
}